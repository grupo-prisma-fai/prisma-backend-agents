# Copia este archivo a .env y rellena los valores reales.

# -------- Servicio --------
ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Procesos uvicorn (default 1). Cada worker suma ~1 core de throughput, pero
# tiene su propia caché de agentes y su propio rate limit (límite efectivo
# hasta N × RATE_LIMIT_MAX). Se ignora con ENV=dev porque reload exige 1.
# WEB_CONCURRENCY=2

# -------- Worker (V1: stub no-op) --------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=10

# -------- AWS S3 (bucket de conocimiento multi-agente) --------
# Estructura multi-tenant: s3://<bucket>/org=<university_code>/agents/<agent_id>/...
# El placeholder {university_code} del prefijo se resuelve POR REQUEST con el
# segmento /api/v1/universities/{university_code}/ de la ruta.
S3_BUCKET=westfield-agent-knowledge
AWS_REGION=us-east-1
# Solo para layouts que NO sigan la convención:
# S3_PREFIX=org={university_code}/agents

# Credenciales AWS — boto3 usa la cadena estándar. En local lo usual es
# `aws sso login` + AWS_PROFILE, o estas dos líneas:
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# En EC2/ECS/Lambda NO van: el rol IAM de la instancia/tarea las provee.

# -------- Secrets Manager (producción) --------
# Si está definida, al arrancar se lee este secreto (JSON plano de
# {"OPENAI_API_KEY": "...", "OPENAI_API_KEY_<AGENTE>": "..."}) y se vuelca al
# entorno del proceso: las keys no quedan en disco. Si no se puede leer, el
# arranque se corta. Las env vars ya definidas ganan sobre el secreto.
# SECRETS_MANAGER_SECRET_ID=prisma-agents/prod/openai

# -------- Registry (caché de agentes en memoria) --------
# TTL de cada agente cargado. Cambios publicados en S3 tardan hasta este
# TTL en reflejarse en el runtime (no hace falta reiniciar).
# REGISTRY_TTL_SECONDS=300
# REGISTRY_NEGATIVE_TTL_SECONDS=30

# -------- OpenAI (proveedor LLM por defecto) --------
# En producción vienen de SECRETS_MANAGER_SECRET_ID; acá solo para dev local.
# Sin OPENAI_API_KEY los agentes arrancan igual pero responden su
# fallback_message (modo degradado controlado).
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL_FALLBACK=text-embedding-3-small

# -------- Keys dedicadas por agente (control de gastos) --------
# Convención: OPENAI_API_KEY_<AGENT_ID en MAYÚSCULAS, guiones → guión bajo>.
# Creá una key por agente desde un proyecto distinto de OpenAI y el dashboard
# (platform.openai.com → Usage) separa el gasto de cada uno solo.
# El agente que no tenga la suya usa OPENAI_API_KEY, con un warning 🟡 al cargarse.
# Verificable en: GET /api/v1/universities/<u>/agents/<agent_id>/health → "api_key".
# OPENAI_API_KEY_MAIA=sk-proj-...
# OPENAI_API_KEY_ARIA=sk-proj-...
# OPENAI_API_KEY_WESTY=sk-proj-...
# OPENAI_API_KEY_MINERVA=sk-proj-...
# OPENAI_API_KEY_MINERVA_LEADERSHIP=sk-proj-...
# OPENAI_API_KEY_MINERVA_MARKETING_MANAGEMENT=sk-proj-...
# OPENAI_API_KEY_MINERVA_STRATEGIC_MANAGEMENT=sk-proj-...
# OPENAI_API_KEY_GREGORIO_III=sk-proj-...
# OPENAI_API_KEY_STUDENT_SERVICES=sk-proj-...

# -------- Rate limit (por IP + agente) --------
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX=12
